{
  "name": "com.sky.portal",
  "displayName": "VirtPort",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application that responds to the deviceready event.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "^14.0.1",
    "cordova-browser": "^7.0.0",
    "cordova-electron": "^4.0.0",
    "cordova-plugin-advanced-http": "^3.3.1",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-fullscreen": "^1.3.0",
    "cordova-plugin-insomnia": "github:EddyVerbruggen/Insomnia-PhoneGap-Plugin",
    "cordova-plugin-networkinterface": "^2.2.0",
    "cronapp-cordova-plugin-barcodescanner": "^4.4.7",
    "express": "^5.1.0"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android",
      "electron"
    ],
    "plugins": {
      "cordova-plugin-advanced-http": {
        "ANDROIDBLACKLISTSECURESOCKETPROTOCOLS": "SSLv3,TLSv1"
      },
      "cordova-plugin-file": {},
      "cordova-plugin-networkinterface": {},
      "cordova-plugin-fullscreen": {},
      "cordova-plugin-insomnia": {},
      "cronapp-cordova-plugin-barcodescanner": {
        "ANDROID_SUPPORT_V4_VERSION": "27.+"
      }
    }
  },
  "dependencies": {
    "axios": "^1.11.0",
    "crypto-js": "^4.2.0"
  }
}